PORT=3000
NODE_ENV=development

# Database
# Local (docker compose): use DB_* abaixo.
# Render / Cloud: cole o Internal Database URL em DATABASE_URL e nao use localhost.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
DB_HOST=your_database_host
DB_PORT=your_database_port
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_NAME=your_database_name
# Render exige SSL. Em production o app liga SSL sozinho. Local: DB_SSL=false
# DB_SSL=true

# JWT
JWT_SECRET=your_jwt_secret
JWT_TTL=300 ## 5 minutos
JWT_REFRESH_TTL=604800 ## 7 dias

# Frontend (link de recuperação de senha e origem CORS)
# Deve ser a origem exata do app: scheme + host + porta (ex.: http://localhost:5173)
FRONTEND_URL=your_frontend_url

# Email
# Sandbox (Mailtrap): captura o e-mail, NAO entrega na caixa real.
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=1e7c643a8f1389
# EMAIL_PASSWORD=840f0ffed6e378
# EMAIL_FROM=noreply@movieflix.com
#
# Entrega real (Gmail): preencha user/senha de app e comente o bloco sandbox acima.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your_email@gmail.com